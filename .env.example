# --- Database ---------------------------------------------------------
# SQLite for local dev. For production, point this at Postgres instead, e.g.
# postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth / Auth.js v5) --------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Set to true when deploying behind a reverse proxy / platform like Vercel, Fly, Render.
AUTH_TRUST_HOST="true"

# Local sign-in fallback — lets you use the whole app without any Google
# credentials configured. Leave ADMIN_PASSWORD unset to disable this path.
ADMIN_USERNAME="jamie"
ADMIN_PASSWORD=""
ADMIN_EMAIL="jamie@example.com"

# --- Google OAuth (Sheets read/write, Gmail read-only, Calendar read-only) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console, enable the Sheets, Gmail and Calendar APIs on the project, and add
# <your-app-url>/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated list of Google account emails allowed to sign in. Required
# whenever GOOGLE_CLIENT_ID/SECRET are set — Google sign-in is refused for
# anyone not on this list, regardless of whether they can complete the
# Google consent screen.
ALLOWED_GOOGLE_EMAILS="jamieyacoubian@googlemail.com"

# --- Google Sheets CRM --------------------------------------------------
# The "Jamie & Margaret — London Rental CRM" spreadsheet ID (from its URL).
CRM_SPREADSHEET_ID="1PqiAYnI88zF3IfnE9xHAAGxKakzuitOC4mm7sfC-unM"

# --- Map provider --------------------------------------------------------
# "mapbox" or "google". Both tokens below are public/client-side by design
# (domain-restrict them in the provider's dashboard) — neither is a secret.
NEXT_PUBLIC_MAP_PROVIDER="mapbox"
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
